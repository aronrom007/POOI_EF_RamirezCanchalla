@model IEnumerable<POOI_EF_RamírezCanchalla.Models.Consumidor>

@{
    ViewBag.Title = "Consumidores";
}

<h2>Lista de Consumidores</h2>

@if (TempData["msgOk"] != null)
{
    <div id="msgOk" style="color:green; font-weight:bold; margin:10px 0;">@TempData["msgOk"]</div>
}


<p>
    @Html.ActionLink("Agregar nuevo comsumidor", "Create")
</p>
@if (!Model.Any())
{
    <p><b>No hay registros</b></p>
}
else
{
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.dnicont)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.nomcont)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.apecont)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.emailcont)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idpais)
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.dnicont)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.nomcont)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.apecont)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.emailcont)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.idpais)
                </td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = item.dnicont }) |
                    @Html.ActionLink("Detalle", "Details", new { id = item.dnicont }) |
                    @Html.ActionLink("Eliminar", "Delete", new { id = item.dnicont })
                </td>
            </tr>
        }

    </table>
}

    @section Scripts {
        <script>
             setTimeout(function () {
             var m = document.getElementById("msgOk");
             if (m) { m.style.display = "none"; }
             }, 5000);
        </script>
    }
